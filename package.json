{
  "name": "tradeflow-flow-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive, editable graph panel for TradeFlow Mapper topology (desks, venues, products, software, destinations) backed by Memgraph via a REST API.",
  "scripts": {
    "build": "webpack --config ./.config/webpack/webpack.config.js --env production",
    "dev": "webpack --watch --config ./.config/webpack/webpack.config.js --env development",
    "typecheck": "tsc --noEmit"
  },
  "author": "rshashi",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emotion/css": "^11.13.0",
    "@grafana/data": "^13.0.0",
    "@grafana/runtime": "^13.0.0",
    "@grafana/ui": "^13.0.0",
    "@types/dagre": "^0.7.54",
    "dagre": "^0.8.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reactflow": "^11.11.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^7.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.6.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
